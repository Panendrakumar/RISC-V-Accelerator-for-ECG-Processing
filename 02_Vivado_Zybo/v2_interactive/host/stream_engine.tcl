# Vivado-side engine for streaming test beats into the v2 board over JTAG-to-AXI.
# Sourced by a per-run Tcl file generated by stream_test_beats.py, which first sets:
#   ::LTX    path of zybo_vit_v2_top.ltx
#   ::BEATS  list of {test_index {99 hex words, lowest address first} rr_hex_word}
# Prints one line per beat:
#   RESULT <test_index> <class> <cycles> <l0> <l1> <l2> <l3> <l4>
#   FAIL <test_index> <reason>
# Does not reprogram the FPGA.

open_hw_manager
connect_hw_server -allow_non_jtag
open_hw_target
set dev [lindex [get_hw_devices xc7z010*] 0]
current_hw_device $dev
set_property PROBES.FILE $::LTX $dev
set_property FULL_PROBES.FILE $::LTX $dev
refresh_hw_device -update_hw_probes false $dev
set ::axi [lindex [get_hw_axis] 0]
if {$::axi eq ""} { puts "FATAL no JTAG-to-AXI master; program zybo_vit_v2_interactive.bit"; exit 2 }
reset_hw_axi $::axi

proc rd {addr len} {
    create_hw_axi_txn -force rdtx $::axi -address [format %08X $addr] -len $len -type read
    run_hw_axi -quiet [get_hw_axi_txns rdtx]
    set raw [string tolower [get_property DATA [get_hw_axi_txns rdtx]]]
    # DATA comes back highest address first; return a list lowest address first.
    set words {}
    for {set i [expr {$len - 1}]} {$i >= 0} {incr i -1} {
        lappend words [string range $raw [expr {$i * 8}] [expr {$i * 8 + 7}]]
    }
    return $words
}

proc wr {addr words} {
    # words: list, lowest address first
    set len [llength $words]
    if {$::ORDER eq "high_first"} {
        set data [join [lreverse $words] "_"]
    } else {
        set data [join $words "_"]
    }
    create_hw_axi_txn -force wrtx $::axi -address [format %08X $addr] -len $len -type write -data $data
    run_hw_axi -quiet [get_hw_axi_txns wrtx]
}

proc s32 {hex} {
    set v [scan $hex %x]
    if {$v >= 0x80000000} { set v [expr {$v - 0x100000000}] }
    return $v
}

# Check the board firmware is the v2 interactive image.
set magic [lindex [rd 0x6000 1] 0]
if {$magic ne "ec600002"} { puts "FATAL firmware magic is $magic, expected ec600002"; exit 3 }

# Detect the burst write word order once, using the host scratch buffer.
set ::ORDER high_first
set probe {a0000000 a0000001 a0000002 a0000003}
wr 0x6100 $probe
if {[rd 0x6100 4] ne $probe} {
    set ::ORDER low_first
    wr 0x6100 $probe
    if {[rd 0x6100 4] ne $probe} { puts "FATAL cannot determine AXI write word order"; exit 4 }
}
puts "INFO write_order=$::ORDER"

set t_start [clock milliseconds]
set n 0
foreach beat $::BEATS {
    lassign $beat idx words rr
    wr 0x6100 $words
    wr 0x6300 [list $rr]
    if {$n < 3 && [rd 0x6100 99] ne $words} { puts "FAIL $idx readback_mismatch"; incr n; continue }

    set seq0 [scan [lindex [rd 0x600C 1] 0] %x]
    wr 0x6004 [list 00000001]
    set done 0
    for {set p 0} {$p < 400} {incr p} {
        set st [rd 0x6008 2]
        set status [scan [lindex $st 0] %x]
        set seq    [scan [lindex $st 1] %x]
        if {$seq != $seq0 && $status == 2} { set done 1; break }
        if {$status == 3 || $status == 4} { break }
    }
    if {!$done} { puts "FAIL $idx status=$status"; incr n; continue }

    set r [rd 0x6010 9]
    set cls    [scan [lindex $r 0] %x]
    set cycles [scan [lindex $r 1] %x]
    set src    [scan [lindex $r 2] %x]
    if {$src != 0} { puts "FAIL $idx wrong_source=$src"; incr n; continue }
    set logits {}
    foreach w [lrange $r 4 8] { lappend logits [s32 $w] }
    puts "RESULT $idx $cls $cycles [join $logits { }]"
    incr n
    if {$n % 25 == 0} { flush stdout }
}
set elapsed [expr {([clock milliseconds] - $t_start) / 1000.0}]
puts "INFO beats=$n elapsed_s=$elapsed"
close_hw_target
disconnect_hw_server
